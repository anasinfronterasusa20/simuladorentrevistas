# Supabase — obligatorio en dev y en Vercel
# Encuentra estos valores en: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# CRM — webhook de n8n que empuja el diagnóstico a Kommo.
# Si se deja vacío, la herramienta funciona igual: guarda en Supabase y
# muestra el resultado, simplemente no notifica al CRM.
CRM_WEBHOOK_URL=""

# Opcional. Si se define, se envía en el header X-SFG-Signature para que el
# workflow de n8n pueda rechazar peticiones que no vengan de esta app.
CRM_WEBHOOK_SECRET=""
